{
  "expo": {
    "name": "Juntadapp",
    "slug": "juntadapp",
    "scheme": "juntadapp",
    "experiments": {
      "typedRoutes": true
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/juntadapp.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.juntadapp.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.juntadapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/juntadapp.png",
        "monochromeImage": "./assets/juntadapp-b&w.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/juntadapp.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96635380-fb15-4128-865a-370fddd96753"
      }
    }
  }
}
