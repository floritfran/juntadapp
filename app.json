{
  "expo": {
    "name": "Juntadapp",
    "slug": "juntadapp",
    "scheme": "juntadapp",
    "experiments": {
      "typedRoutes": true
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/juntadapp.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.juntadapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/juntadapp.png",
        "monochromeImage": "./assets/juntadapp-b&w.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/juntadapp.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      "expo-router",
      "expo-font"
    ]
  }
}
